# --- LLM / embedding provider (DeepInfra, OpenAI-compatible) ---
DEEPINFRA_API_KEY=your_deepinfra_api_key
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
EXTRACTION_WORKERS=8
EXTRACTION_MODEL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Neo4j (brew services start neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Set your own password here; it is also used by docker-compose.yml.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Retrieval / chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=8
GRAPH_HOPS=2
GRAPH_ENTITY_SEEDS=5
GRAPH_MAX_FACTS=40

# --- Dataset / corpus ---
# DATASET_NAME: "hotpotqa" (download) or "files" (use DOCS_DIR markdown/text)
DATASET_NAME=hotpotqa
DATASET_SPLIT=validation
NUM_EXAMPLES=30
# DOCS_DIR is scanned recursively for .md/.txt when DATASET_NAME=files.
DOCS_DIR=data

# --- Langfuse (optional tracing) ---
# For Langfuse Cloud: use your cloud keys + https://cloud.langfuse.com.
# For the self-hosted stack: the same two keys below are auto-provisioned by
# docker-compose.langfuse.yml, so pick any values here and keep them secret.
# Leave both keys blank to disable tracing.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- DeepEval (LLM-as-judge metrics) ---
DEEPEVAL_METRICS=contextual_recall,contextual_precision,faithfulness,answer_relevancy
DEEPEVAL_THRESHOLD=0.5
DEEPEVAL_TELEMETRY_OFF=true

# --- Prefect ---
PREFECT_SERVER_ANALYTICS_ENABLED=false

# --- Self-hosted Langfuse stack (docker-compose.langfuse.yml) ---
# Consumed by the compose file, not the app. Set any local values; keep them
# secret. Required for `make langfuse` / `make up` when Docker is used.
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_USER_EMAIL=demo@example.com
LANGFUSE_INIT_USER_PASSWORD=
